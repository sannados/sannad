# Environment: development | production
SANNAD_ENV=development

SANNAD_KERNEL_ADDR=:8081
SANNAD_GATEWAY_ADDR=:8080

# SQLite for local development (default)
SANNAD_DATABASE_DSN=./sannad.db
# PostgreSQL for production:
# SANNAD_DATABASE_DSN=postgres://sannad:sannad@localhost:5432/sannad?sslmode=disable

# Must be at least 32 characters. Do not use the default value.
SANNAD_SESSION_SECRET=replace-this-with-a-random-32-char-minimum-secret

SANNAD_KAYAN_ISSUER=http://localhost:8080

# Comma-separated allowed CORS origins. Use * for development only.
SANNAD_CORS_ORIGINS=*

# Maximum requests per second per IP on the gateway. Set to 0 to disable.
SANNAD_RATE_LIMIT=60

# HTTP server timeouts in seconds.
SANNAD_READ_TIMEOUT=15
SANNAD_WRITE_TIMEOUT=30
SANNAD_IDLE_TIMEOUT=65

# Maximum request body size in bytes (default: 4 MiB = 4194304).
SANNAD_BODY_LIMIT=4194304

# Logging level: debug, info, warn, error
SANNAD_LOG_LEVEL=info

# Enables subdomain tenant resolution for unauthenticated requests: with
# "sannad.example", a request to tenant-a.sannad.example resolves to "tenant-a".
# Leave empty to have register and login name their tenant in the request body.
# Authenticated requests always take the tenant from the signed session token.
SANNAD_TENANT_BASE_DOMAIN=
