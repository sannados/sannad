# Copy to .env in this directory. docker compose reads it automatically.
# Every value below with no default is required — compose refuses to start
# without it, naming exactly which one is missing.

# Postgres credentials for the compose-managed database. Change these from
# any example value before running against real data; there is no default
# password, deliberately — see docs/operations/backup-and-dr.md.
POSTGRES_USER=sannad
POSTGRES_PASSWORD=
POSTGRES_DB=sannad

# Must be at least 32 characters. Generate one with, e.g.:
#   openssl rand -base64 32
SANNAD_SESSION_SECRET=

# Set when rotating SANNAD_SESSION_SECRET: move the retiring value here
# first. Comma-separated for more than one still-live retired secret. Leave
# empty otherwise. See docs/operations/backup-and-dr.md.
SANNAD_SESSION_SECRET_PREVIOUS=

# Comma-separated allowed CORS origins. Do not leave as * in production.
SANNAD_CORS_ORIGINS=*

SANNAD_RATE_LIMIT=60
SANNAD_RATE_LIMIT_PER_TENANT=300

# Days a nightly logical backup is kept before the backup container prunes
# it. See docs/operations/backup-and-dr.md for what this does and does not
# protect against.
BACKUP_RETENTION_DAYS=14

# OTLP endpoint for traces, e.g. http://otel-collector:4317. Empty disables.
SANNAD_OTEL_ENDPOINT=
